# ============================================================================
#  .env.example  —  LOCAL settings & secrets for running on YOUR machine.
# ============================================================================
#  Set up once:   cp .env.example .env      then edit .env
#
#   • .env is git-ignored — your secrets never get committed.
#   • Anything set here OVERRIDES automation.config.js at runtime.
#   • In CI (Bitbucket) you do NOT use this file — those values come from
#     repository variables instead (see README.md).
# ============================================================================

# ── Which platform are you running locally? ─────────────────────────────────
PLATFORM=ios                       # "ios" or "android"

# ── Local device (running against your own simulator / emulator) ────────────
APPIUM_SERVER=http://127.0.0.1:4723
# UDID of your simulator / emulator / device:
#   iOS:      xcrun simctl list      → the device's UDID
#   Android:  adb devices            → the serial in the left column
APPIUM_UDID=
# Optional: path to a local .app / .ipa / .apk to (re)install before testing.
# Leave blank if the app is already installed on the device.
APP_PATH=

# ── BrowserStack (only needed to run the CLOUD matrix from your machine) ─────
# Leave BROWSERSTACK=false for local device runs.
BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# bs://... URL from an App Automate upload — required when BROWSERSTACK=true
BS_APP_URL=
# Optional: pin a single device for a quick cloud smoke test (otherwise the full
# matrix from automation.config.js runs).
# BS_DEVICE=iPhone 15
# BS_OS_VERSION=17

# ── TestRail (only used when publishing results) ────────────────────────────
# The numeric IDs can also live in automation.config.js; the SECRETS must stay
# here (or in repository variables) and never in a committed file.
TESTRAIL_BASE_URL=
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SUITE_ID=

# ── Handy overrides (optional) ──────────────────────────────────────────────
# Which sections to run: "all", or a comma-separated list e.g. "auth,example"
TEST_SECTIONS=all
# Keep the throwaway-account password out of automation.config.js if you prefer:
TEST_ACCOUNT_PASSWORD=
