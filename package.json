{
  "name": "mobile-e2e-template",
  "version": "1.0.0",
  "description": "Appium + Mocha mobile E2E template — clone, point at your app, run on BrowserStack.",
  "main": "test.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "mocha test.js",
    "test:ios": "PLATFORM=ios mocha test.js",
    "test:android": "PLATFORM=android mocha test.js",
    "test:ci": "node core/matrix.js -- --reporter mocha-junit-reporter",
    "upload": "node scripts/upload-to-browserstack.js",
    "verdict": "node core/verdict.js"
  },
  "license": "ISC",
  "dependencies": {
    "browserstack-node-sdk": "^1.0.0",
    "mocha": "^11.7.5",
    "mocha-junit-reporter": "^2.2.1"
  }
}
