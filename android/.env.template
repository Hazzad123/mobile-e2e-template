# Copy this file to .env. Never commit .env.

# App identity
APP_DISPLAY_NAME=__APP_DISPLAY_NAME__
APP_PACKAGE=__ANDROID_PACKAGE__
APP_ACTIVITY=__ANDROID_LAUNCH_ACTIVITY__

# Local Appium 2 device/emulator
APPIUM_SERVER=http://127.0.0.1:4723
APPIUM_UDID=__ANDROID_DEVICE_SERIAL__
NO_RESET=true

# Test behaviour
TEST_SECTIONS=all
TIMEOUT_MULTIPLIER=1
MAX_CONSECUTIVE_FAILURES=3
RECOVER_AFTER_FAILURE=true
RESTART_APP_AFTER_FAILURE=true

# Set true only for local work when the team does not use TestRail. Sections may
# then use reviewed LOCAL-* labels. BrowserStack/CI still requires verified C### IDs.
ALLOW_UNMAPPED_TESTRAIL_CASES=false

# Account created by sections/account-setup.js
E2E_EMAIL_PREFIX=e2e+mobile
E2E_EMAIL_DOMAIN=__SAFE_TEST_EMAIL_DOMAIN__
E2E_TEST_PASSWORD=__SAFE_TEST_PASSWORD__

# Selectors and TestRail case IDs live at the top of sections/*.js so they are
# reviewed and versioned with each test. Environment variables with the same
# names can override them temporarily.

# BrowserStack App Automate (only required when BROWSERSTACK=true)
BROWSERSTACK=false
BROWSERSTACK_USERNAME=__BROWSERSTACK_USERNAME__
BROWSERSTACK_ACCESS_KEY=__BROWSERSTACK_ACCESS_KEY__
BS_APP_URL=bs://__UPLOADED_APP_ID__
BS_DEVICE=Google Pixel 10
BS_OS_VERSION=16.0
BS_APPIUM_VERSION=2.0.1
BROWSERSTACK_PROJECT_NAME=__BROWSERSTACK_PROJECT_NAME__

# TestRail (required by npm run test:ci)
TESTRAIL_BASE_URL=https://__ORGANISATION__.testrail.io
TESTRAIL_USERNAME=__TESTRAIL_USERNAME__
TESTRAIL_API_KEY=__TESTRAIL_API_KEY__
TESTRAIL_PROJECT_ID=__TESTRAIL_PROJECT_ID__
TESTRAIL_SUITE_ID=__OPTIONAL_TESTRAIL_SUITE_ID__
TESTRAIL_PLAN_PREFIX=__TESTRAIL_MONTHLY_PLAN_PREFIX__
